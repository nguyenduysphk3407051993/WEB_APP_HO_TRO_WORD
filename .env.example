# ============ Traefik ============
APP_DOMAIN=app.edutechnd.io.vn
TRAEFIK_NETWORK=traefik-network
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_HTTPS_ENTRYPOINT=websecure

# ============ 9router API ============
# Có thể để trống nếu sẽ nhập key qua trang Quản lý API Keys.
# Hỗ trợ một key hoặc danh sách nhiều key phân cách bằng dấu phẩy.
NINEROUTER_API_KEY=
NINEROUTER_API_KEYS=
NINEROUTER_BASE_URL=https://9router.edutechnd.org/v1
NINEROUTER_MODEL=cx/gpt-5.5
NINEROUTER_MAX_CONCURRENT_PER_KEY=3
NINEROUTER_RETRY_ATTEMPTS=3
NINEROUTER_TIMEOUT_SECONDS=180
NINEROUTER_MAX_TOKENS=16384

# ============ Admin ============
# BẮT BUỘC: mật khẩu vào trang quản lý keys trên web
# Chọn mật khẩu mạnh — đây là cửa duy nhất bảo vệ keys của bạn
ADMIN_PASSWORD=doi_mat_khau_nay_di
