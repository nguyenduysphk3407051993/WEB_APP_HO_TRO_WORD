# ============ Traefik ============
APP_DOMAIN=app.edutechnd.io.vn
TRAEFIK_NETWORK=traefik-network
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_HTTPS_ENTRYPOINT=websecure

# ============ Gemini API ============
# Có thể để TRỐNG nếu bạn sẽ nhập keys qua giao diện web (khuyến nghị)
# Nếu set ở đây thì sẽ là fallback khi file /app/data/keys.json chưa có
GEMINI_API_KEYS=

GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_CONCURRENT_PER_KEY=3
GEMINI_RETRY_ATTEMPTS=3
GEMINI_TIMEOUT_SECONDS=120

# ============ Admin ============
# BẮT BUỘC: mật khẩu vào trang quản lý keys trên web
# Chọn mật khẩu mạnh — đây là cửa duy nhất bảo vệ keys của bạn
ADMIN_PASSWORD=doi_mat_khau_nay_di
