# Cấu hình cho deployment qua Traefik (đã khớp với setup hiện tại)
# Copy file này thành `.env` rồi điều chỉnh nếu cần.

# Domain ứng dụng
APP_DOMAIN=app.edutechnd.io.vn

# Tên network external mà Traefik dùng (xác nhận bằng: `docker network ls`)
TRAEFIK_NETWORK=traefik-network

# Tên cert resolver — khớp với certificatesResolvers.<name> trong traefik.yml
TRAEFIK_CERT_RESOLVER=letsencrypt

# Tên entrypoint HTTPS — khớp với entryPoints.<name> trong traefik.yml
TRAEFIK_HTTPS_ENTRYPOINT=websecure
