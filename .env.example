# ============ Traefik ============
APP_DOMAIN=app.edutechnd.io.vn
TRAEFIK_NETWORK=traefik-network
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_HTTPS_ENTRYPOINT=websecure

# ============ Gemini API ============
# Danh sách 10 API key, phân cách bằng dấu phẩy (KHÔNG có khoảng trắng giữa các key)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEYS=AIzaSy_KEY_1,AIzaSy_KEY_2,AIzaSy_KEY_3,AIzaSy_KEY_4,AIzaSy_KEY_5,AIzaSy_KEY_6,AIzaSy_KEY_7,AIzaSy_KEY_8,AIzaSy_KEY_9,AIzaSy_KEY_10

# Model: gemini-2.0-flash (free, nhanh, tốt cho công thức)
#        gemini-2.5-flash (mới hơn, chính xác hơn)
#        gemini-2.5-pro (chậm, chính xác nhất, có tính phí ngoài free)
GEMINI_MODEL=gemini-2.0-flash

# Giới hạn request song song trên mỗi key (free tier: 15 RPM, để 3 là an toàn)
GEMINI_MAX_CONCURRENT_PER_KEY=3

# Số lần retry khi gặp lỗi (sẽ thử các key khác)
GEMINI_RETRY_ATTEMPTS=3

# Timeout cho mỗi request Gemini (giây)
GEMINI_TIMEOUT_SECONDS=120
